{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BugTools",
  "version": "0.1.0",
  "identifier": "com.bugtools.workstation",
  "build": {
    "beforeDevCommand": "npm --prefix apps/desktop run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix apps/desktop run build",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "BugTools — Security Research Workstation",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
